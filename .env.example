# ==========================================
# VOC Platform - Environment Configuration
# Copy to .env and fill in your values
# ==========================================
# NOTE: docker-compose requires every secret marked REQUIRED below (no
# insecure defaults). Missing values make `docker compose up` fail fast.
#
# Generate strong secrets with:  openssl rand -hex 32

# ==========================================
# REQUIRED - CORE SECRETS
# ==========================================
RABBITMQ_USER=voc                                   # REQUIRED (non-secret)
RABBITMQ_PASS=change-me-strong-password             # REQUIRED
REDIS_PASSWORD=change-me-strong-password            # REQUIRED
ELASTIC_PASSWORD=change-me-strong-password          # REQUIRED
ES_KIBANA_PASSWORD=change-me-strong-password        # REQUIRED (kibana_system user)
PORTAL_SECRET=change-me-openssl-rand-hex-32         # REQUIRED (JWT signing key)
PORTAL_ADMIN_PASSWORD=change-me-strong-password     # REQUIRED

# ==========================================
# NETWORK / DISCOVERY (REQUIRED)
# ==========================================
# Explicitly authorized CIDRs only - scanning is refused without a valid list.
DISCOVERY_SUBNET=192.168.184.0/24

# ==========================================
# MISP Threat Intelligence (REQUIRED)
# ==========================================
MISP_URL=https://192.168.184.135:8443
MISP_KEY=your-misp-api-key-here
MISP_VERIFY_SSL=true
MISP_CONCURRENCY=8

# ==========================================
# GLPI IT Service Management (REQUIRED)
# ==========================================
GLPI_URL=http://192.168.184.135:8080
GLPI_APP_TOKEN=your-glpi-app-token
GLPI_USER_TOKEN=your-glpi-user-token
GLPI_VERIFY_SSL=true

# Risk Engine API key (REQUIRED)
# openssl rand -hex 32
RISK_ENGINE_API_KEY=change-me-openssl-rand-hex-32
RISK_ENGINE_URL=http://risk-engine:8000

# ==========================================
# OPTIONAL - INFRASTRUCTURE
# ==========================================
LOGSTASH_URL=http://logstash:5044
ES_URL=http://elasticsearch:9200
ES_USER=elastic
ELASTIC_USER=elastic

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

MARIADB_ROOT_PASSWORD=change-me-strong-password     # REQUIRED
MARIADB_DATABASE=glpi
MARIADB_USER=glpi
MARIADB_PASSWORD=change-me-strong-password          # REQUIRED

MISP_DB_ROOT_PASSWORD=change-me-strong-password     # REQUIRED
MISP_DB_DATABASE=misp
MISP_DB_USER=misp
MISP_DB_PASSWORD=change-me-strong-password          # REQUIRED
MISP_ADMIN_EMAIL=admin@voc.local                    # REQUIRED
MISP_ADMIN_PASSPHRASE=change-me-strong-password     # REQUIRED
MISP_BASE_URL=https://192.168.184.135:8443

FLEET_SERVER_TOKEN=change-me-openssl-rand-hex-32    # REQUIRED
FLEET_SERVER_POLICY_ID=fleet-server-policy

# Kibana encryption keys (REQUIRED, >=32 chars, unique per deployment)
# ROTATION NOTE: changing these invalidates previously encrypted saved objects.
XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=change-me-openssl-rand-hex-32
XPACK_SECURITY_ENCRYPTIONKEY=change-me-openssl-rand-hex-32
XPACK_REPORTING_ENCRYPTIONKEY=change-me-openssl-rand-hex-32

KIBANA_HOST=0.0.0.0
KIBANA_PORT=5601
VOC_PUBLIC_HOST=localhost

# ==========================================
# VOC PORTAL
# ==========================================
PORTAL_ADMIN_USERNAME=admin
# Demo users (analyst1/user1/user2) share this password; empty = do not create
PORTAL_DEMO_PASSWORD=
# Explicit opt-in ONLY for labs: allow seeding admin with password 'admin'
PORTAL_ALLOW_DEFAULT_ADMIN=false
# Embed credentials into SSO deep-links (leaks via history; lab demos only)
VOC_SSO_EMBED_CREDENTIALS=false
# Brute-force protection on /api/login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ==========================================
# RISK ENGINE (v3 contextual scoring)
# ==========================================
RISK_ENGINE_HOST=0.0.0.0
RISK_ENGINE_PORT=8000
DEFAULT_NETWORK_EXPOSURE=0.3
DEFAULT_CRITICAL_ASSET=false
DEFAULT_EXPLOIT_AVAILABLE=false
# Boosts (backward compatible defaults)
RISK_KEV_BOOST=2.0
RISK_EPSS_THRESHOLD=0.5
RISK_EPSS_BOOST=1.0
RISK_MISP_BOOST=2.0
RISK_EXPLOIT_BOOST=1.5
RISK_EXPOSURE_MULTIPLIER=2.0
RISK_INTERNET_EXPOSED_FLOOR=1.5
RISK_PRODUCTION_BOOST=0.5
RISK_ATTACK_PATH_WEIGHT=1.0

# ==========================================
# SLA MANAGEMENT (Feature 7) - remediation budgets, hours
# Defaults: Critical 24h, High 72h, Medium 7d, Low 30d
# ==========================================
SLA_CRITICAL_HOURS=24
SLA_HIGH_HOURS=72
SLA_MEDIUM_HOURS=168
SLA_LOW_HOURS=720
SLA_DUE_SOON_HOURS=24

# ==========================================
# SMART TICKET ROUTING (Feature 8)
# ==========================================
ROUTING_MIN_RATE_CRITICAL=0.7
ROUTING_MAX_OPEN_CRITICAL=5

# ==========================================
# AUTHENTICATED SCANNING (Feature 4)
# ==========================================
# OpenVAS/Greenbone GMP endpoint. Empty OPENVAS_HOST = adapter disabled,
# platform keeps running nmap-only. Never fakes results when unreachable.
OPENVAS_HOST=
OPENVAS_PORT=9390
OPENVAS_USER=
OPENVAS_PASS=
OPENVAS_TIMEOUT=30
# Scanner used for remediation-verification re-scans (nmap | openvas)
VERIFICATION_SCANNER=nmap
# Extra nmap CLI args for full host scans
NMAP_SCAN_ARGS=-sS -sV --version-intensity 5 -O -p- -T4

# ==========================================
# NMAP NSE ACTIVE VULNERABILITY CHECKS ("super powers")
# ==========================================
# Second scan phase that actively CHECKS for specific CVEs on open ports
# (smb-vuln-*, http-vuln-cve-*, ssl-heartbleed, ...) upgrading findings from
# 'potential' (version match) to 'confirmed' (evidence-backed).
# Default expression is detection-only: it EXCLUDES dos/intrusive/exploit
# scripts so services are never crashed. Override at your own risk.
NMAP_NSE_VULN_SCAN=true
NMAP_VULN_SCRIPTS=vuln and not (dos or intrusive)
NSE_HOST_TIMEOUT=20m

# ==========================================
# NOTIFICATIONS (Feature 11)
# ==========================================
# Comma-separated provider list; 'log' always works as fallback
NOTIFICATION_PROVIDERS=log
NOTIFY_CRITICAL_RISK_THRESHOLD=9.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ==========================================
# TICKET ENRICHMENT / THREAT INTEL
# ==========================================
EPSS_API_URL=https://api.first.org/data/v1/epss
KEV_CATALOG_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
OSV_API_URL=https://api.osv.dev
EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
VIRUSTOTAL_API_KEY=
TI_CACHE_TTL=86400
EXPLOITDB_REFRESH_HOURS=24
NVD_CACHE_TTL=86400
CHECKLIST_IN_GLPI=true

# ==========================================
# DATA RETENTION / RESILIENCE
# ==========================================
# ILM deletion age (days) for pipeline + telemetry indices; 0 disables ILM
DATA_RETENTION_DAYS=14
# Redis diff-state lock TTL (seconds) for long full-subnet scans
SCAN_LOCK_TTL=10800
# How long resolved-finding tombstones persist for reopen detection (seconds)
RESOLVED_TOMBSTONE_TTL=2592000

# ==========================================
# CELERY (informational - compose sets BROKER_URL/RESULT_BACKEND directly)
# ==========================================
CELERY_BROKER_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_TIMEZONE=UTC

LOG_LEVEL=INFO

# ==========================================
# TOOLS HUB (optional integrations)
# ==========================================
# Kibana dashboard iframe embed URL (generate in Kibana: Share > Embed code)
KIBANA_EMBED_URL=
# Remote Shuffle (SOAR) instance - see docs/EXTRA_TOOLS.md
SHUFFLE_URL=
# Zabbix web URL as reachable from the browser
ZABBIX_PUBLIC_URL=http://localhost:8081

# --- Only needed when starting the optional zabbix profile ---
# docker compose --profile zabbix up -d
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=zabbix-set-strong-password-before-enabling
ZABBIX_DB_NAME=zabbix
ZABBIX_TZ=UTC
